{
  "$schema": "https://raw.githubusercontent.com/akhilsbehl/pie-permission-auto-review-codex/refs/heads/master/schemas/config.schema.json",
  "provider": "openai-codex",
  "model": "codex-auto-review",
  "reasoning": "low",
  "timeoutMs": 90000,
  "rules": {
    "allow": {
      "commands": [
        "cargo build",
        "cargo build *",
        "cargo check",
        "cargo check *",
        "cargo test",
        "cargo test *",
        "cat *",
        "cmp *",
        "comm *",
        "date",
        "df",
        "df *",
        "diff *",
        "du",
        "du *",
        "egrep *",
        "fd *",
        "fgrep *",
        "file *",
        "git blame *",
        "git branch",
        "git diff",
        "git diff *",
        "git log",
        "git log *",
        "git ls-files",
        "git ls-files *",
        "git remote -v",
        "git rev-parse *",
        "git show",
        "git show *",
        "git status",
        "git status *",
        "git worktree list",
        "git stash list",
        "git tag --list",
        "git tag --list *",
        "go test",
        "go test *",
        "grep *",
        "head *",
        "hostname",
        "id",
        "less *",
        "ls",
        "ls *",
        "make build",
        "make check",
        "make lint",
        "make test",
        "more *",
        "npm --version",
        "npm list",
        "npm list *",
        "npm outdated",
        "npm outdated *",
        "npm run build",
        "npm run check",
        "npm run lint",
        "npm run test",
        "npm run typecheck",
        "npm test",
        "npm test *",
        "pip --version",
        "pnpm --version",
        "pnpm list",
        "pnpm list *",
        "pnpm outdated",
        "pnpm outdated *",
        "pnpm run build",
        "pnpm run check",
        "pnpm run lint",
        "pnpm run test",
        "pnpm test",
        "pnpm test *",
        "pnpm why *",
        "pwd",
        "pytest",
        "pytest *",
        "python -m pytest",
        "python -m pytest *",
        "rg *",
        "stat *",
        "tail *",
        "tree",
        "tree *",
        "type *",
        "uname",
        "uname *",
        "uptime",
        "wc *",
        "which *",
        "whoami"
      ],
      "paths": [
        "$CWD",
        "/tmp",
        "~/tmp",
        "~/.richie",
        "~/.pi",
        "~/warchives"
      ]
    },
    "block": {
      "commands": [
        "blkdiscard*",
        "mkfs*",
        "dd*",
        "rm -rf /",
        "*shutdown*",
        "*reboot*",
        "*poweroff*",
        "wipefs*"
      ],
      "paths": [
        "~/.ssh",
        "~/.gnupg",
        "~/.netrc",
        "~/.git-credentials",
        "~/.zscaler-cert.pem",
        "~/.zshrc.more"
      ]
    }
  }
}
