{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "authorizerChain": [
    "auto-review"
  ],
  "piInfrastructureReadPaths": [
    "~/*"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*.key": "ask",
      "~/.ssh/*": "ask",
      "~/.gnupg": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask",
      "~/.azure/*": "ask",
      "~/.config/gcloud/*": "ask",
      "~/.config/gh/*": "ask",
      "~/.kube/*": "ask",
      "~/.docker/config.json": "ask",
      "~/.npmrc": "ask",
      "~/.pypirc": "ask",
      "~/.netrc": "ask",
      "~/.git-credentials": "ask",
      "~/.zscaler-cert.pem": "ask",
      "~/.zshrc.more": "ask"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "ask_user_question": "allow",
    "jobs": "allow",
    "jina_read": "allow",
    "jina_search": "allow",
    "jina_deepsearch": "allow",
    "agent_browser": "allow",
    "web_search": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "subagent_spawn": "allow",
    "subagent": "allow",
    "subagent_control": "allow",
    "get_subagent_result": "allow",
    "subagent_check": "allow",
    "agent_bg": "allow",
    "start_specialist": "allow",
    "inspect_specialists": "allow",
    "steer_subagent": "allow",
    "subagent_wait": "allow",
    "write": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow"
    },
    "edit": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow"
    },
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "which *": "allow",
      "type *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git branch": "allow",
      "git remote -v": "allow",
      "pnpm --version": "allow",
      "npm --version": "allow",
      "pip --version": "allow",
      "pnpm list *": "allow",
      "pnpm why *": "allow",
      "pnpm outdated *": "allow",
      "npm list *": "allow",
      "npm outdated *": "allow",
      "pnpm test": "allow",
      "pnpm run test": "allow",
      "pnpm run lint": "allow",
      "pnpm run lint:md": "allow",
      "pnpm run check": "allow",
      "pnpm run build": "allow",
      "npm test": "allow",
      "npm run test": "allow",
      "npm run lint": "allow",
      "npm run check": "allow",
      "npm run typecheck": "allow",
      "npm run build": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "python -m pytest": "allow",
      "python -m pytest *": "allow",
      "cargo test *": "allow",
      "cargo check *": "allow",
      "cargo build *": "allow",
      "go test *": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make check": "allow",
      "make build": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow",
      "~/tmp/personal/*": "ask"
    }
  }
}
