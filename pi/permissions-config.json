      "python -m pytest": "allow",
      "python -m pytest *": "allow",
      "cargo test *": "allow",
      "cargo check *": "allow",
      "cargo build *": "allow",
      "go test *": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make check": "allow",
      "make build": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow",
      "~/tmp/personal/*": "ask"
    }
