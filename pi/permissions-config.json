{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "authorizerChain": ["auto-review"],
  "piInfrastructureReadPaths": ["~/*"],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*.key": "ask",
      "~/.ssh/*": "ask",
      "~/.gnupg": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask",
      "~/.azure/*": "ask",
      "~/.config/gcloud/*": "ask",
      "~/.config/gh/*": "ask",
      "~/.kube/*": "ask",
      "~/.docker/config.json": "ask",
      "~/.npmrc": "ask",
      "~/.pypirc": "ask",
      "~/.netrc": "ask",
      "~/.git-credentials": "ask",
      "~/.zscaler-cert.pem": "ask",
      "~/.zshrc.more": "ask",
      "/mnt/c/Users/akhil.behl": "ask",
      "/mnt/c/Users/akhil.behl/*": "ask",
      "/home/akhil/configs/CODING_PRINCIPLES.md": "allow",
      "/home/akhil/configs/WRITING_PRINCIPLES.md": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow",
      "~/tmp/personal/*": "ask"
    },
    "edit": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/tmp/*": "allow",
      "~/.richie/*": "allow",
      "~/tmp/personal/*": "ask"
    },
    "bash": {
      "*": "ask",
      "git *": "ask",
      "pnpm *": "ask",
      "npm *": "ask",
      "pip *": "ask",
      "make *": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "echo *": "ask",
      "printf *": "ask",
      "tee *": "ask",
      "sed -i *": "ask",
      "sort -o *": "ask",
