{
  "lastChangelogVersion": "1.0.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "persistModelSelection": false,
  "defaultThinkingLevel": "off",
  "hideThinkingBlock": true,
  "packages": [
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:pi-context-view",
    {
      "source": "npm:pi-bg-tasks",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "npm:@narumitw/pi-starship",
      "skills": []
    },
    {
      "source": "npm:pi-subagents",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "git:github.com/akhilsbehl/pi-muse-spark"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 120,
    "clearOnShrink": false,
    "showImages": false
  },
  "quietStartup": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5",
    "google/gemini-flash-latest",
    "meta-ai/muse-spark-1.3-contributor",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openai-codex/gpt-6-astra",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-5.6-luna",
    "google/gemini-flash-lite-latest",
    "google/gemini-3.1-pro-preview"
  ],
  "showHardwareCursor": true,
  "editorPaddingX": 0,
  "autocompleteMaxVisible": 10,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "none",
  "treeFilterMode": "all",
  "subagents": {
    "disableBuiltins": true
  },
  "extensions": [
    "-builtin:llama.cpp",
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search"
  ],
  "images": {
    "autoResize": false
  },
  "showCacheMissNotices": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "fullscreenExitOutput": "transcript"
}