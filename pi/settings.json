{
  "lastChangelogVersion": "0.84.3",
  "theme": "neobones_light_contrast",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "persistModelSelection": false,
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    {
      "source": "npm:pi-bg-tasks",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "git:github.com/algal/pi-openai-server-compaction",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:@narumitw/pi-starship",
    "npm:pi-context-view",
    {
      "source": "npm:pi-subagents",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    }
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "quietStartup": false,
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "google/gemini-flash-lite-latest",
    "google/gemini-flash-latest",
    "google/gemini-3.1-pro-preview",
    "openrouter/stealth/ox-alpha"
  ],
  "observational-memory": {
    "observeAfterTokens": 25000,
    "reflectAfterTokens": 25000,
    "compactAfterTokens": 100000,
    "compactAfterTokensMode": "ratio",
    "compactAfterTokensRatio": 0.25,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "passive": true,
    "debugLog": false
  },
  "showHardwareCursor": true,
  "editorPaddingX": 0,
  "autocompleteMaxVisible": 10,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "none",
  "treeFilterMode": "all",
  "subagents": {
    "disableBuiltins": true
  }
}