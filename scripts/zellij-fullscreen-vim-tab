#!/usr/bin/env bash
FILE=$(realpath "$1")
SOCK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/nvim-zopen.XXXXXX")
SOCK="$SOCK_DIR/nvim.sock"
SOCK_ID=${SOCK_DIR##*.}
TAB_TITLE="Review-$SOCK_ID"

# Run the complete Neovim lifecycle inside the new tab so the headless server
# inherits the tab's persistent terminal, including when this wrapper is called
# from a non-interactive runner.
if ! zellij action new-tab --name "$TAB_TITLE" -- bash -c 'FILE="$1"; SOCK="$2"; SOCK_DIR="$3"; trap '\''rm -rf -- "$SOCK_DIR"'\'' EXIT; zellij action rename-pane "$FILE"; nvim --listen "$SOCK" --headless >/dev/null 2>&1 & until nvim --server "$SOCK" --remote-expr '\''1'\'' 2>/dev/null; do sleep 0.1; done; nvim --server "$SOCK" --remote "$FILE"; until nvim --server "$SOCK" --remote-expr "bufname('\''%'\'') =~ '\''$(basename "$FILE")'\''" 2>/dev/null | grep -q '\''1'\''; do sleep 0.1; done; nvim --server "$SOCK" --remote-send '\''<Esc>:MarkdownPreviewToggle<CR>'\''; nvim --server "$SOCK" --remote-ui; nvim --server "$SOCK" --remote-expr '\''execute("qa!")'\'' >/dev/null 2>&1 || true; rm -rf -- "$SOCK_DIR"; zellij action close-pane' bash "$FILE" "$SOCK" "$SOCK_DIR"; then
    rm -rf -- "$SOCK_DIR"
    exit 1
fi

# Give zellij a moment to open the tab before toggling fullscreen
sleep 0.3
zellij action toggle-fullscreen

exit 0
